# WEkEO credentials — required for downloading data before 2025-01-20
# Register at: https://wekeo.copernicus.eu/register/
WEKEO_USER=your_username
WEKEO_PASSWORD=your_password

# CDSE (Copernicus Data Space Ecosystem) credentials — optional. Tried first
# for any date range that would otherwise go to WEkEO; fills in tile/dates
# from the same HR-WSI archive as they get migrated to CDSE.
# Register free at: https://dataspace.copernicus.eu/
CDSE_USER=your_username
CDSE_PASSWORD=your_password
